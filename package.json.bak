{
  "name": "openclaw-mobile",
  "version": "1.0.0",
  "description": "Full-featured mobile client for OpenClaw - AI chat, task board, secrets vault, security scanner",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "playwright test --config=tests/playwright.config.ts",
    "test:visual": "playwright test --config=playwright-visual.config.ts",
    "test:cross-platform": "playwright test tests/cross-platform.spec.ts --config=tests/playwright.config.ts",
    "test:crypto": "npx ts-node test-crypto.ts",
    "test:all": "npm run test:crypto && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brianference/openclaw-mobile.git"
  },
  "author": "Brian Ference",
  "license": "MIT",
  "keywords": [
    "expo",
    "react-native",
    "openclaw",
    "ai",
    "mobile"
  ],
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@supabase/supabase-js": "^2.95.2",
    "aes-js": "^3.1.2",
    "expo": "^54.0.33",
    "expo-blur": "^15.0.8",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-document-picker": "^14.0.8",
    "expo-haptics": "^15.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~14.0.1",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "^29.0.16",
    "react-dom": "19.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "eslint": "^9.39.2",
    "eslint-config-expo": "^10.0.0",
    "typescript": "^5.9.3"
  }
}
